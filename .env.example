# --- Timezone / working hours ---
TZ_NAME=America/Chicago
WORK_START=9
WORK_END=18

# --- LLM task extraction: tries Groq, then Gemini, then simple keyword rules ---
# Use FREE-tier keys only; never attach billing (see README "Budget safety").
GROQ_API_KEY=
GEMINI_API_KEY=
# hard cap on model calls per day, enforced by the app
LLM_DAILY_CAP=150

# --- Outlook via Microsoft Graph (optional; without it, no calendar is read/written) ---
MS_CLIENT_ID=
MS_TENANT=common
# set to 1 to write time blocks into Outlook when you replan
OUTLOOK_WRITE=1

# --- WhatsApp via Twilio (optional) ---
TWILIO_AUTH_TOKEN=
PUBLIC_URL=https://your-ngrok-url.ngrok-free.app
# only messages from this number are accepted, e.g. whatsapp:+1713XXXXXXX
ALLOWED_WHATSAPP=
